# ─────────────────────────────────────────────
# LLM Provider (OpenRouter handles all models, including Gemini)
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# ─────────────────────────────────────────────
# Vector Database — Pinecone
# ─────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=apirag-1024

# ─────────────────────────────────────────────
# Jina AI — Embeddings + Reranking (one key for both)
# ─────────────────────────────────────────────
JINA_API_KEY=your_jina_key_here
EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024
JINA_RERANK_MODEL=jina-reranker-v1-base-en
JINA_TOP_N=10

# LlamaParse (Advanced PDF Parsing)
LLAMA_CLOUD_API_KEY=your_llama_cloud_key_here3

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
PORT=5000

# ─────────────────────────────────────────────
# Optional: pricing display (USD per 1K tokens)
# ─────────────────────────────────────────────
MODEL_PRICE_IN=0.0003
MODEL_PRICE_OUT=0.0015




#Redis 
UPSTASH_REDIS_REST_URL= 
UPSTASH_REDIS_REST_TOKEN=


SEMANTIC_CACHE_THRESHOLD=0.90
